# ============================================================
# Trident Agent MVP — Environment Variables
# ============================================================
# 复制此文件为 .env 并填入你的真实 API 密钥
#   cp .env.example .env
# ============================================================

# ── DeepSeek (Agent Chat + 替补 LLM) ───────────────────────
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ── Agent LLM (Data Copilot, 默认复用 DeepSeek) ────────────
AGENT_LLM_BASE_URL=https://api.deepseek.com/v1
AGENT_LLM_API_KEY=sk-your-deepseek-key-here
AGENT_LLM_MODEL=deepseek-chat

# ── OpenRouter (Kimi K3 + DeepSeek + Gemini + Grok + ChatGPT) ─
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# ── xAI / Grok (备用，现通过 OpenRouter 调用) ──────────────
XAI_API_KEY=xai-your-xai-key-here

# ── Doubao (火山引擎，已暂停) ──────────────────────────────
DOUBAO_API_KEY=ark-your-doubao-key-here
DOUBAO_MODEL=ep-your-endpoint-id
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ── MetaTrader 5 (可选) ────────────────────────────────────
# MT5_LOGIN=your_mt5_account
# MT5_PASSWORD=your_mt5_password
# MT5_SERVER=your_mt5_broker_server

# ── Binance (可选) ─────────────────────────────────────────
# BINANCE_API_KEY=your_binance_api_key
# BINANCE_API_SECRET=your_binance_api_secret

# ── Network Proxy (可选) ───────────────────────────────────
HTTP_PROXY=http://127.0.0.1:10808

# ── TreeNews Bridge (可选) ──────────────────────────────────
TREE_NEWS_PORT=9000

# ── Frontend (Next.js) ─────────────────────────────────────
# 在 frontend/.env.local 中设置:
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
