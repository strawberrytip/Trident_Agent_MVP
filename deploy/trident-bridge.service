# Trident TreeNews 桥（wss://news.treeofalpha.com → engine webhook 127.0.0.1:9000）
# 部署路径假设为 /opt/trident，venv 在 /opt/trident/venv — 按需修改
# 依赖 engine 的 webhook 端口，故排在 trident-engine 之后启动
[Unit]
Description=Trident Agent - TreeNews Bridge
After=network-online.target trident-engine.service
Wants=network-online.target

[Service]
Type=simple
User=trident
WorkingDirectory=/opt/trident/backend/src_python
EnvironmentFile=/opt/trident/backend/.env
ExecStart=/opt/trident/venv/bin/python treenews_bridge.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
